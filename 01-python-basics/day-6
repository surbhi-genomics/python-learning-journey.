Q1. Convert ages into a set

ages = [19, 20, 21, 19, 22, 20, 23, 21]

ages_set = set(ages)

print("Length of list:", len(ages))
print("Length of set:", len(ages_set))

# Q2. Difference between data types

string = "Python"
my_list = [1, 2, 3]
my_tuple = (1, 2, 3)
my_set = {1, 2, 3}

print(type(string))
print(type(my_list))
print(type(my_tuple))
print(type(my_set))

# Q3. Count unique words

sentence = "I am a teacher and I love to inspire and teach people."

words = sentence.split()
unique_words = set(words)

print("Unique words:", unique_words)
print("Number of unique words:", len(unique_words))
